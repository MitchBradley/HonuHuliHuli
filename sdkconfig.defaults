CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000

# Keep the RMT refill interrupt running while flash is written (NVS saves
# can happen mid-move); the step encoder callback is in IRAM.
CONFIG_RMT_TX_ISR_CACHE_SAFE=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# Browsers send long headers; the 512-byte default gives 431 errors
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

CONFIG_LWIP_LOCAL_HOSTNAME="honuhuli"
